{
  "name": "@metacubexd/ui",
  "version": "1.272.0",
  "description": "Chinese Web console for the SOCKS gateway",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --host",
    "format": "pnpm prettier --write --ignore-unknown .",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test:e2e": "vitest run e2e/ --pool=threads",
    "test:unit": "vitest run --exclude='e2e/**'",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@tabler/icons-vue": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "daisyui": "catalog:",
    "ky": "catalog:",
    "nuxt": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@prettier/plugin-oxc": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
