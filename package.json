{
  "name": "metacubexd-monorepo",
  "version": "1.272.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.1",
  "scripts": {
    "dev": "pnpm dev:ui",
    "dev:ui": "pnpm --filter @metacubexd/ui dev",
    "dev:server": "pnpm build:ui && pnpm --filter @metacubexd/server dev",
    "build:ui": "pnpm --filter @metacubexd/ui generate",
    "build:server": "pnpm --filter @metacubexd/server... build",
    "build": "pnpm build:ui && pnpm build:server",
    "test": "pnpm --filter @metacubexd/agent test && pnpm --filter @metacubexd/server test && pnpm --filter @metacubexd/ui test:unit",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm --filter @metacubexd/ui lint",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "catalog:",
    "commitlint": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "lint-staged": "catalog:"
  }
}
