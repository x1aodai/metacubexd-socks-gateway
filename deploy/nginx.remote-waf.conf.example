# Install this server block on the separate BaoTa/Nginx WAF machine.
# Before use, replace gateway.example.com, REPLACE_WITH_GATEWAY_ORIGIN_IP and
# REPLACE_WITH_CLASH_SECRET. The origin firewall must allow 8080/9090 only from
# this WAF machine's fixed public IP.
server {
    listen 443 ssl http2;
    server_name gateway.example.com;

    ssl_certificate     /path/to/fullchain.pem;
    ssl_certificate_key /path/to/privkey.pem;

    client_max_body_size 8m;

    location / {
        proxy_pass http://REPLACE_WITH_GATEWAY_ORIGIN_IP:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
    }

    location = /_gateway_auth {
        internal;
        proxy_pass http://REPLACE_WITH_GATEWAY_ORIGIN_IP:8080/api/auth/check;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-Original-URI $request_uri;
    }

    location /mihomo/ {
        auth_request /_gateway_auth;
        proxy_pass http://REPLACE_WITH_GATEWAY_ORIGIN_IP:9090/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Authorization "Bearer REPLACE_WITH_CLASH_SECRET";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
    }
}
