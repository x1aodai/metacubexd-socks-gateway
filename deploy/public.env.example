# Direct public HTTP mode. The panel derives port 9090 from its current domain.
# This intentionally exposes the management UI and Mihomo API without TLS.
GATEWAY_IMAGE=ghcr.io/x1aodai/metacubexd-socks-gateway:latest
TZ=Asia/Shanghai
CONTROL_BIND_ADDRESS=0.0.0.0
CLASH_API_BIND_ADDRESS=0.0.0.0
CLASH_API_CORS_ORIGINS=*
DEFAULT_BACKEND_URL=
PUBLIC_DIRECT_ACCESS=true
SOCKS_PORT_MIN=1080
SOCKS_PORT_MAX=1099
SESSION_COOKIE_SECURE=false
