# Direct public HTTP mode. Replace gateway.example.com before starting.
# This intentionally exposes the management UI and Mihomo API without TLS.
GATEWAY_IMAGE=ghcr.io/x1aodai/metacubexd-socks-gateway:latest
TZ=Asia/Shanghai
CONTROL_BIND_ADDRESS=0.0.0.0
CLASH_API_BIND_ADDRESS=0.0.0.0
CLASH_API_CORS_ORIGINS=http://gateway.example.com:8080
DEFAULT_BACKEND_URL=http://gateway.example.com:9090
SOCKS_PORT_MIN=1080
SOCKS_PORT_MAX=1099
SESSION_COOKIE_SECURE=false
