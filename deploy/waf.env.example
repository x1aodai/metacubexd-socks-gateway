# Remote WAF mode: the origin ports bind on every IPv4 interface.
# Restrict TCP 8080 and 9090 to the WAF server's fixed source IP in both the
# cloud security group and the host firewall before starting the container.
GATEWAY_IMAGE=ghcr.io/x1aodai/metacubexd-socks-gateway:latest
TZ=Asia/Shanghai
CONTROL_BIND_ADDRESS=0.0.0.0
CLASH_API_BIND_ADDRESS=0.0.0.0
SOCKS_PORT_MIN=1080
SOCKS_PORT_MAX=1099
SESSION_COOKIE_SECURE=true
